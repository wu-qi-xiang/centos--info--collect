DJANGO_SETTINGS_MODULE=PyLinux.settings
DJANGO_ENV=production
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DATA_ENCRYPTION_KEY=change-me-to-a-separate-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,example.com

# 默认不配置时使用本地 SQLite；生产建议使用 mysql 或 postgresql。
DB_ENGINE=mysql
DB_NAME=pylinux
DB_USER=pylinux
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_CHARSET=utf8mb4

EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
GUNICORN_ACCESS_LOG=logs/gunicorn-access.log
GUNICORN_ERROR_LOG=logs/gunicorn-error.log

WEBSSH_SESSION_TIMEOUT_SECONDS=1800
NOTIFICATION_DEDUP_SECONDS=300
NOTIFICATION_RETRY_COUNT=0
NOTIFICATION_TIMEOUT_SECONDS=5
DEVOPS_TASK_RETRY_COUNT=0
DEVOPS_SSH_CONNECT_TIMEOUT_SECONDS=10
DEVOPS_COMMAND_TIMEOUT_SECONDS=60
DEVOPS_COMMAND_OUTPUT_MAX_BYTES=204800
AUDIT_LOG_RETENTION_DAYS=0
METRIC_SAMPLE_RETENTION_DAYS=30

# K8s 详情查询缓存。目录需可写；容器重启后需保留缓存时请挂载持久卷。
K8S_CACHE_DIR=.cache/k8s
K8S_DETAIL_CACHE_TIMEOUT_SECONDS=86400
