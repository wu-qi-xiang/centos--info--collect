DJANGO_SETTINGS_MODULE=PyLinux.settings
# Supported runtime baseline: Python 3.11 and Django 4.2.16 (pinned in requirements files).
DJANGO_ENV=production
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DATA_ENCRYPTION_KEY=change-me-to-a-separate-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,example.com

# 默认不配置时使用本地 SQLite。PostgreSQL/Nginx 参考部署通过未跟踪环境文件
# 设置 DB_NAME、DB_USER、DB_PASSWORD；其 Compose 覆盖层固定 DB_ENGINE=postgresql。
DB_ENGINE=mysql
DB_NAME=pylinux
DB_USER=pylinux
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_CHARSET=utf8mb4

EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
GUNICORN_ACCESS_LOG=logs/gunicorn-access.log
GUNICORN_ERROR_LOG=logs/gunicorn-error.log

WEBSSH_SESSION_TIMEOUT_SECONDS=1800
NOTIFICATION_DEDUP_SECONDS=300
NOTIFICATION_RETRY_COUNT=0
NOTIFICATION_TIMEOUT_SECONDS=5
DEVOPS_SCHEDULER_INTEGRATION_HEALTH_INTERVAL_SECONDS=300
# Read-only local Operator Scan scheduler interval.
DEVOPS_SCHEDULER_OPERATOR_SCAN_INTERVAL_SECONDS=300
# 企业微信群机器人仅发送出站通知。配置公开 HTTPS 基址后，审批通知会附带短期、登录后仍会复核权限的跳转链接。
PLATFORM_PUBLIC_BASE_URL=https://ops.example.com
WECOM_APPROVAL_LINK_TTL_SECONDS=900
# Jenkins/GitLab CI 回调：留空即拒绝对应 provider 的入站回调。值仅存在部署环境，禁止提交。
# 请求必须带 X-CI-Signature: sha256=<HMAC-SHA256 原始请求体>，回调只写入安全摘要。
JENKINS_CI_WEBHOOK_SECRET=
GITLAB_CI_WEBHOOK_SECRET=
# 入站企业微信 ChatOps：留空即禁用；非空值至少 32 个字符且仅保存在部署环境。
# 接入方使用 X-WeCom-Signature: sha256=<原始请求体 HMAC-SHA256>；仅允许查询、告警确认和已有页面跳转，不执行命令或发布。
WECOM_CHATOPS_WEBHOOK_SECRET=
DEVOPS_TASK_RETRY_COUNT=0
DEVOPS_WORKER_POLL_SECONDS=1
DEVOPS_WORKER_MAX_ATTEMPTS=1
DEVOPS_WORKER_JOB_TIMEOUT_SECONDS=300
DEVOPS_SSH_CONNECT_TIMEOUT_SECONDS=10
DEVOPS_COMMAND_TIMEOUT_SECONDS=60
DEVOPS_COMMAND_OUTPUT_MAX_BYTES=204800
# Host Agent health evaluator. The scheduler opens a local alert after timeout.
DEVOPS_SCHEDULER_AGENT_HEALTH_INTERVAL_SECONDS=60
# Read-only Prometheus/Alertmanager/WeCom transport health probe interval.
DEVOPS_SCHEDULER_INTEGRATION_HEALTH_INTERVAL_SECONDS=300
AGENT_HEARTBEAT_TIMEOUT_SECONDS=600
AUDIT_LOG_RETENTION_DAYS=0
METRIC_SAMPLE_RETENTION_DAYS=30
AIOPS_ANALYSIS_RETENTION_DAYS=90
SERVICE_SLO_EVALUATION_RETENTION_DAYS=90

# 备份对象存储：BACKUP_S3_BUCKET 留空时禁用异地上传。归档加密使用现有 DATA_ENCRYPTION_KEY，
# 不要新增或提交备份密钥。可省略访问密钥以使用 AWS IAM 角色、IRSA 等默认凭据链。
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=pylinux
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_SESSION_TOKEN=
BACKUP_S3_VERIFY_SSL=True

# K8s 详情查询缓存。目录需可写；容器重启后需保留缓存时请挂载持久卷。
K8S_CACHE_DIR=.cache/k8s
K8S_DETAIL_CACHE_TIMEOUT_SECONDS=86400

# 外部认证默认关闭：保留本地账号密码登录。启用任一来源时必须设置角色映射。
EXTERNAL_AUTH_ROLE_MAP={"<external-group-viewers>":"viewer","<external-group-operators>":"operator","<external-group-admins>":"admin"}

# OIDC：全部留空时禁用；启用时四项都必填。生产环境必须使用 HTTPS，回调主机必须属于 DJANGO_ALLOWED_HOSTS。
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# LDAP/AD：全部留空时禁用；启用时七项都必填。生产使用 ldaps://，或 ldap:// 配合 LDAP_STARTTLS=True。
LDAP_SERVER_URI=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_USER_FILTER=
LDAP_GROUP_ATTRIBUTE=
LDAP_STARTTLS=
